# Configure these in your hosting provider (Netlify) > Environment Variables.
# For Netlify: Site configuration > Environment variables
# Keep real values out of site.js, Git, screenshots, and browser code.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
REGISTRATION_SECRET=copy-the-generated-value-from-apps-script-properties
